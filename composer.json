{
    "name": "sandman/whats-on",
    "description": "Divi 5 module: carousel of upcoming events from The Events Calendar.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "brain/monkey": "^2.6",
        "pestphp/pest": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "WhatsOn\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WhatsOn\\Tests\\": "tests/php/"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
