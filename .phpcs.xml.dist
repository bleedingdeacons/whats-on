<?xml version="1.0"?>
<ruleset name="whats-on">
    <description>PSR-12 coding standard for the What's On plugin.</description>

    <file>src</file>
    <file>tests</file>
    <file>whats-on.php</file>
    <file>build.php</file>

    <arg name="basepath" value="."/>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>

    <rule ref="PSR12">
        <!-- Line endings are normalised by git (`* text=auto eol=lf`). This sniff
             would only ever fire on a working copy checked out with CRLF. -->
        <exclude name="Generic.Files.LineEndings"/>

        <!-- PSR-12's 120-character limit. The long lines here are HTML in the
             carousel markup and sprintf templates, where wrapping costs more than
             it gives. -->
        <exclude name="Generic.Files.LineLength"/>

        <!-- Every source file carries the mandatory WordPress
             `if (!defined('ABSPATH')) { exit; }` guard, which PSR-1 counts as a side
             effect alongside the declarations. Not removable. -->
        <exclude name="PSR1.Files.SideEffects"/>
    </rule>

    <!-- Divi calls these by name (render_callback, module_classnames,
         module_styles) and its own modules use the same snake_case, so they
         cannot be renamed. -->
    <rule ref="PSR1.Methods.CamelCapsMethodName">
        <exclude-pattern>src/Divi/*</exclude-pattern>
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>

    <!-- Test helpers and WP_* stubs are deliberately global, deliberately not
         PascalCase, and grouped in the file that uses them. -->
    <rule ref="PSR1.Classes.ClassDeclaration">
        <exclude-pattern>tests/*</exclude-pattern>
        <!-- build.php is a standalone CLI build script, never autoloaded and never
             shipped; its PluginBuilder class is deliberately global. -->
        <exclude-pattern>build\.php</exclude-pattern>
    </rule>
    <rule ref="Squiz.Classes.ValidClassName">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <rule ref="PSR12.Files.FileHeader">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
</ruleset>
