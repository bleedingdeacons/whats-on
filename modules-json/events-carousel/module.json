{
  "name": "whats-on/events-carousel",
  "d4Shortcode": "",
  "title": "What's On",
  "titles": "What's On",
  "description": "A carousel of upcoming events from The Events Calendar.",
  "keywords": ["events", "event carousel", "the events calendar", "upcoming events", "whats on"],
  "moduleIcon": "divi/module-group-carousel",
  "category": "module",
  "attributes": {
    "module": {
      "type": "object",
      "selector": "{{selector}}",
      "settings": {
        "meta": {
          "adminLabel": []
        },
        "advanced": {
          "html": [],
          "link": [],
          "text": {
            "priority": 10
          }
        },
        "decoration": {
          "animation": [],
          "attributes": [],
          "background": [],
          "border": [],
          "boxShadow": [],
          "conditions": [],
          "disabledOn": [],
          "filters": [],
          "interactions": [],
          "overflow": [],
          "order": [],
          "position": [],
          "scroll": [],
          "sizing": [],
          "spacing": [],
          "sticky": [],
          "transform": [],
          "transition": [],
          "zIndex": []
        }
      }
    },
    "events": {
      "type": "object",
      "default": {
        "advanced": {
          "count": { "desktop": { "value": "9" } },
          "featuredOnly": { "desktop": { "value": "off" } },
          "showTime": { "desktop": { "value": "on" } }
        }
      },
      "settings": {
        "advanced": {
          "count": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentEvents",
              "attrName": "events.advanced.count",
              "label": "Number of Events",
              "description": "How many upcoming events to show in the carousel.",
              "priority": 10,
              "render": true,
              "features": { "hover": false, "sticky": false, "responsive": false, "preset": "content" },
              "component": {
                "type": "field",
                "name": "divi/range",
                "props": { "min": 1, "max": 24, "minLimit": 1, "maxLimit": 50, "step": 1, "allowedUnits": [], "defaultUnit": "" }
              }
            }
          },
          "categories": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentEvents",
              "attrName": "events.advanced.categories",
              "label": "Event Categories",
              "description": "Comma-separated event category slugs to include. Leave blank for all categories.",
              "priority": 20,
              "render": true,
              "features": { "hover": false, "sticky": false, "responsive": false, "preset": "content" },
              "component": { "type": "field", "name": "divi/text" }
            }
          },
          "featuredOnly": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentEvents",
              "attrName": "events.advanced.featuredOnly",
              "label": "Featured Events Only",
              "description": "Only show events marked as featured in The Events Calendar.",
              "priority": 30,
              "render": true,
              "features": { "hover": false, "sticky": false, "responsive": false, "preset": "content" },
              "component": { "type": "field", "name": "divi/toggle" }
            }
          },
          "dateFormat": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentEvents",
              "attrName": "events.advanced.dateFormat",
              "label": "Date Format",
              "description": "Leave blank to show dates in the site language's regional format. To override it, enter a PHP date format, e.g. D j M Y.",
              "priority": 40,
              "render": true,
              "features": { "hover": false, "sticky": false, "responsive": false, "preset": "content" },
              "component": { "type": "field", "name": "divi/text" }
            }
          },
          "showTime": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentEvents",
              "attrName": "events.advanced.showTime",
              "label": "Show Time",
              "description": "Show the start and end time after the date.",
              "priority": 50,
              "render": true,
              "features": { "hover": false, "sticky": false, "responsive": false, "preset": "content" },
              "component": { "type": "field", "name": "divi/toggle" }
            }
          },
          "noEventsText": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentEvents",
              "attrName": "events.advanced.noEventsText",
              "label": "No Events Text",
              "description": "Shown when there are no upcoming events. Leave blank for the default message.",
              "priority": 60,
              "render": true,
              "features": { "hover": false, "sticky": false, "responsive": false, "preset": "content" },
              "component": { "type": "field", "name": "divi/text" }
            }
          }
        }
      }
    },
    "carousel": {
      "type": "object",
      "default": {
        "advanced": {
          "slidesPerView": { "desktop": { "value": "3" }, "tablet": { "value": "2" }, "phone": { "value": "1" } },
          "loop": { "desktop": { "value": "off" } }
        }
      },
      "settings": {
        "advanced": {
          "slidesPerView": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentCarousel",
              "attrName": "carousel.advanced.slidesPerView",
              "label": "Events Per View",
              "description": "How many event cards are visible at once. Set different values for tablet and phone.",
              "priority": 10,
              "render": true,
              "features": { "hover": false, "sticky": false, "preset": ["style"] },
              "component": {
                "type": "field",
                "name": "divi/range",
                "props": { "min": 1, "max": 6, "minLimit": 1, "maxLimit": 6, "step": 1, "allowedUnits": [], "defaultUnit": "" }
              }
            }
          },
          "loop": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentCarousel",
              "attrName": "carousel.advanced.loop",
              "label": "Loop",
              "description": "Wrap around to the first event after the last one (and back).",
              "priority": 20,
              "render": true,
              "features": { "hover": false, "sticky": false, "responsive": false, "preset": "content" },
              "component": { "type": "field", "name": "divi/toggle" }
            }
          }
        }
      }
    },
    "card": {
      "type": "object",
      "selector": "{{selector}} .whats-on__card",
      "styleProps": {
        "background": [],
        "border": [],
        "boxShadow": [],
        "spacing": []
      },
      "settings": {
        "decoration": {
          "background": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designCard",
              "priority": 10,
              "render": true,
              "component": { "type": "group", "name": "divi/background", "props": { "grouped": true } }
            }
          },
          "border": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designCard",
              "priority": 20,
              "render": true,
              "component": { "type": "group", "name": "divi/border", "props": { "grouped": true } }
            }
          },
          "boxShadow": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designCard",
              "priority": 30,
              "render": true,
              "component": { "type": "group", "name": "divi/box-shadow", "props": { "grouped": true } }
            }
          }
        }
      }
    },
    "image": {
      "type": "object",
      "selector": "{{selector}} .whats-on__image",
      "styleProps": {
        "border": [],
        "filters": { "selector": "{{selector}} .whats-on__image img" }
      },
      "settings": {
        "decoration": {
          "border": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designImage",
              "priority": 10,
              "render": true,
              "component": { "type": "group", "name": "divi/border", "props": { "grouped": true } }
            }
          },
          "filters": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designImage",
              "priority": 20,
              "render": true,
              "component": { "type": "group", "name": "divi/filters", "props": { "grouped": true } }
            }
          }
        }
      }
    },
    "title": {
      "type": "object",
      "selector": "{{selector}} .whats-on__title",
      "default": {
        "decoration": {
          "font": { "font": { "desktop": { "value": { "headingLevel": "h3" } } } }
        }
      },
      "settings": {
        "decoration": {
          "font": {
            "priority": 20,
            "component": {
              "props": {
                "groupLabel": "Title Text",
                "fieldLabel": "Title",
                "fields": { "headingLevel": { "render": true } }
              }
            }
          }
        }
      }
    },
    "date": {
      "type": "object",
      "selector": "{{selector}} .whats-on__date",
      "settings": {
        "decoration": {
          "font": {
            "priority": 30,
            "component": {
              "props": {
                "groupLabel": "Date Text",
                "fieldLabel": "Date"
              }
            }
          }
        }
      }
    },
    "arrows": {
      "type": "object",
      "selector": "{{selector}} .whats-on__nav",
      "default": {
        "advanced": {
          "show": { "desktop": { "value": "on" } }
        }
      },
      "styleProps": {
        "background": [],
        "border": [],
        "boxShadow": []
      },
      "settings": {
        "advanced": {
          "show": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentCarousel",
              "attrName": "arrows.advanced.show",
              "label": "Show Previous / Next Buttons",
              "description": "Display the previous and next buttons.",
              "priority": 30,
              "render": true,
              "features": { "hover": false, "sticky": false, "responsive": false, "preset": "content" },
              "component": { "type": "field", "name": "divi/toggle" }
            }
          },
          "color": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designArrows",
              "attrName": "arrows.advanced.color",
              "label": "Arrow Color",
              "description": "Colour of the arrow icon.",
              "priority": 10,
              "render": true,
              "component": { "type": "field", "name": "divi/color-picker" }
            }
          }
        },
        "decoration": {
          "background": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designArrows",
              "priority": 20,
              "render": true,
              "component": { "type": "group", "name": "divi/background", "props": { "grouped": true } }
            }
          },
          "border": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designArrows",
              "priority": 30,
              "render": true,
              "component": { "type": "group", "name": "divi/border", "props": { "grouped": true } }
            }
          },
          "boxShadow": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designArrows",
              "priority": 40,
              "render": true,
              "component": { "type": "group", "name": "divi/box-shadow", "props": { "grouped": true } }
            }
          }
        }
      }
    }
  },
  "customCssFields": {
    "track": { "label": "Track", "subName": "track", "selectorSuffix": " .whats-on__track" },
    "card": { "label": "Event Card", "subName": "card", "selectorSuffix": " .whats-on__card" },
    "image": { "label": "Featured Image", "subName": "image", "selectorSuffix": " .whats-on__image img" },
    "title": { "label": "Title", "subName": "title", "selectorSuffix": " .whats-on__title" },
    "date": { "label": "Date", "subName": "date", "selectorSuffix": " .whats-on__date" },
    "arrows": { "label": "Previous / Next Buttons", "subName": "arrows", "selectorSuffix": " .whats-on__nav" }
  },
  "settings": {
    "content": "auto",
    "design": "auto",
    "advanced": "auto",
    "groups": {
      "contentEvents": {
        "panel": "content",
        "priority": 10,
        "groupName": "contentEvents",
        "component": { "name": "divi/composite", "props": { "groupLabel": "Events" } }
      },
      "contentCarousel": {
        "panel": "content",
        "priority": 20,
        "groupName": "contentCarousel",
        "component": { "name": "divi/composite", "props": { "groupLabel": "Carousel" } }
      },
      "designCard": {
        "panel": "design",
        "priority": 10,
        "groupName": "designCard",
        "component": { "name": "divi/composite", "props": { "groupLabel": "Event Card", "clipboardCategory": "style" } }
      },
      "designImage": {
        "panel": "design",
        "priority": 15,
        "groupName": "designImage",
        "component": { "name": "divi/composite", "props": { "groupLabel": "Image", "clipboardCategory": "style" } }
      },
      "designArrows": {
        "panel": "design",
        "priority": 40,
        "groupName": "designArrows",
        "component": { "name": "divi/composite", "props": { "groupLabel": "Previous / Next Buttons", "clipboardCategory": "style" } }
      }
    }
  }
}
